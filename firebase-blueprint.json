{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Non-PII account metadata, subscription plan, and aggregate feature counters for SaveSmart users.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth user ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "role": {
          "type": "string",
          "enum": ["user"],
          "description": "Standard user role."
        },
        "plan": {
          "type": "string",
          "enum": ["free", "premium"],
          "description": "Subscription tier."
        },
        "currency": {
          "type": "string",
          "enum": ["INR"],
          "description": "Account currency code."
        },
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "IANA timezone such as Asia/Kolkata."
        },
        "expenseCount": {
          "type": "integer",
          "description": "Total logged expenses counter."
        },
        "incomeCount": {
          "type": "integer",
          "description": "Total logged income entries counter."
        },
        "goalCount": {
          "type": "integer",
          "description": "Total savings goals counter."
        },
        "budgetCount": {
          "type": "integer",
          "description": "Total budgets counter."
        },
        "aiQueryCount": {
          "type": "integer",
          "description": "Total AI assistant prompts sent."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "role", "plan", "currency", "timezone", "expenseCount", "incomeCount", "goalCount", "budgetCount", "aiQueryCount", "lastActiveAt", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Strictly owner-only PII profile details including email and city.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "persona": {
          "type": "string",
          "enum": ["student", "young_professional", "first_time_earner", "gig_worker", "other"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Individual INR expense transaction belonging to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["Food", "Transport", "Shopping", "Education", "Entertainment", "Bills", "Health", "Travel", "Other"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Cash", "Debit Card", "Credit Card", "NetBanking", "Wallet", ""]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "amount", "category", "description", "date", "createdAt", "updatedAt"]
    },
    "Income": {
      "title": "Income",
      "description": "Individual INR income entry belonging to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["Salary", "Pocket Money", "Freelance Income", "Business Income", "Allowance", "Other Income"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "amount", "category", "description", "date", "createdAt", "updatedAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly spending limit overall or per category in INR.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "category": {
          "type": "string",
          "enum": ["Overall", "Food", "Transport", "Shopping", "Education", "Entertainment", "Bills", "Health", "Travel", "Other"]
        },
        "limitAmount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "monthKey", "category", "limitAmount", "createdAt", "updatedAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "User savings target with contributions and completion status.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "targetAmount": {
          "type": "number"
        },
        "currentAmount": {
          "type": "number"
        },
        "targetDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "name", "targetAmount", "currentAmount", "targetDate", "status", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Budget warnings, goal progress updates, savings reminders, and summaries.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["budget_warning", "budget_exceeded", "goal_progress", "savings_reminder", "monthly_summary", "account_update"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "type", "title", "message", "read", "createdAt", "updatedAt"]
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "User notification, privacy, and display preferences.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "budgetAlerts80": {
          "type": "boolean"
        },
        "budgetAlerts100": {
          "type": "boolean"
        },
        "savingsReminders": {
          "type": "boolean"
        },
        "goalMilestones": {
          "type": "boolean"
        },
        "monthlyDigest": {
          "type": "boolean"
        },
        "pushEnabled": {
          "type": "boolean"
        },
        "hideBalances": {
          "type": "boolean"
        },
        "aiContextSharing": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "budgetAlerts80", "budgetAlerts100", "savingsReminders", "goalMilestones", "monthlyDigest", "pushEnabled", "hideBalances", "aiContextSharing", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Non-PII user account metadata and aggregate usage counters."
    },
    "/users/{uid}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Owner-isolated PII profile data."
    },
    "/users/{uid}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Owner-isolated INR expense transactions."
    },
    "/users/{uid}/income/{incomeId}": {
      "schema": { "$ref": "#/entities/Income" },
      "description": "Owner-isolated INR income transactions."
    },
    "/users/{uid}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Owner-isolated monthly spending budgets."
    },
    "/users/{uid}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "Owner-isolated savings goals."
    },
    "/users/{uid}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Owner-isolated in-app notifications."
    },
    "/users/{uid}/preferences/{preferenceId}": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "Owner-isolated notification and privacy preferences."
    }
  }
}
